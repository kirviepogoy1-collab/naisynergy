# Copy this file to .env and fill in your real values

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret - change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Server port
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Base URL of the frontend, used to build the link inside "forgot password"
# emails (e.g. https://your-app.onrender.com/reset-password?token=...).
# Optional - if unset, the first entry in CLIENT_ORIGIN above is used instead.
FRONTEND_URL=

# How many reverse-proxy hops to trust for determining a request's real IP
# (used by the IP firewall below and by rate limiting). 1 is correct for
# Render's standard setup. Leave unset to use that default; only change this
# if you know your deployment has a different number of proxy hops.
TRUST_PROXY=1

# Optional IP allowlist ("firewall"). Comma-separated list of IPs and/or
# CIDR ranges (e.g. "203.0.113.5,10.0.0.0/24") allowed to reach the API.
# Leave empty (the default) to allow all IPs - most deployments should leave
# this blank unless you specifically need to restrict access to a known set
# of networks (e.g. a school's on-site IP range).
ALLOWED_IPS=

# Web Push (real browser/phone notifications for chat messages)
# A working key pair is provided below so this works out of the box - it's
# free and safe to use, but you can generate your own anytime by running:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BEf9cawk2KxVW0sAlFfAMwu2rltPy6VPmm8sO4F-93h-MH8w-WHtXa5Rx2FxAZecTGFd8GKYmVIDilw2tb0Xphc
VAPID_PRIVATE_KEY=XJc6A5RybDTBk9RsyGd-Ju_Y0DDuEBZE35Yn2Nvi7LA
VAPID_SUBJECT=mailto:youremail@example.com

# Upstash Redis (optional, free tier) - used for rate limiting and caching.
# Without these, the app still works: rate limiting falls back to in-memory
# (resets on every restart/redeploy) and caching is simply skipped.
# Get these from your database's dashboard at https://console.upstash.com
# (REST API section, not the plain Redis connection string).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Brevo (transactional email) - used for password reset emails, notifications,
# etc. Get an API key from https://app.brevo.com (SMTP & API section).
# BREVO_FROM_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Cloudinary (file/image storage) - used for uploaded documents, receipts,
# and the school logo. Get these from your dashboard at
# https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
